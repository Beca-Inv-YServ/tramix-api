# Copiá este archivo a ".env" y completá tus valores reales.

# Cadena de conexion a Postgres. Si usas Supabase, la encontras en:
# Project Settings > Database > Connection string (modo "Session pooler")
DATABASE_URL=postgresql://usuario:password@localhost:5432/tramites_db

# Tu API key gratuita de Gemini (se obtiene en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aca

# Modelos a usar (Flash es gratuito y rapido; alcanza para este proyecto)
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
